---
import '../styles/global.css';
import '../styles/hybrid.css';
import {site} from '../data/site';
const {title=site.name, description=site.description}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','首页'],['/blog/','博客'],['/projects/','项目'],['/tools/','工具导航'],['/about/','关于']];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <meta name="description" content={description}/>
  <title>{title} · cdsee045</title>
  <link rel="canonical" href={new URL(path,Astro.site)}/>
  <link rel="icon" href="/favicon.svg"/>
  <link rel="alternate" type="application/rss+xml" title="Weijian Li 的博客" href="/rss.xml"/>
</head>
<body>
  <a class="skip" href="#main">跳至内容</a>
  <header class="header">
    <a class="brand" href="/" aria-label="Weijian Li 首页">WL<span>.</span><small>/ cdsee045</small></a>
    <nav aria-label="主导航">{nav.map(([url,label])=><a href={url} aria-current={(url==='/'?path==='/':path.startsWith(url))?'page':undefined}>{label}</a>)}</nav>
  </header>
  <main id="main"><slot/></main>
  <footer><span>© {new Date().getFullYear()} Weijian Li</span><div><a href="/rss.xml">RSS</a><a href={site.github}>GitHub ↗</a><a href="mailto:weijianli@tju.edu.cn">Email</a></div></footer>
</body>
</html>
