---
import Layout from '../layouts/Layout.astro';import {projects} from '../data/site';
---
<Layout title="项目"><span class="eyebrow">Build & learn</span><h1 class="page-title">项目与实践</h1><p class="intro">课程实践、学习记录与公开仓库。</p><div class="grid">{projects.map(p=><a class="card" href={p.url}><span class="tag">{p.tag}</span><span class="arrow">↗</span><h3>{p.name}</h3><p>{p.description}</p></a>)}</div></Layout>
