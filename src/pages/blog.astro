---
import Layout from '../layouts/Layout.astro';import {getPosts} from '../data/articles';const posts=await getPosts();const categories=[...new Set(posts.map(p=>p.category))];
---
<Layout title="博客"><span class="eyebrow">Learning in public</span><h1 class="page-title">笔记与文章</h1><p class="intro">在学习中记录，在实践中理解。共 {posts.length} 篇笔记。</p><input class="search" type="search" id="search" placeholder="搜索标题或正文…" aria-label="搜索文章"/><div class="filters"><button class="filter" aria-pressed="true" data-category="全部">全部</button>{categories.map(c=><button class="filter" aria-pressed="false" data-category={c}>{c}</button>)}</div><div id="results">{posts.map(p=><a class="post-row result" href={`/${p.slug}/`} data-category={p.category} data-search={`${p.title} ${p.category} ${p.html.replace(/<[^>]*>/g,' ')}`.toLowerCase()}><div><h3>{p.title}</h3><p class="post-excerpt">{p.excerpt}</p><span class="meta">{p.category}</span></div><time datetime={p.date}>{p.date}</time></a>)}</div><p id="empty" class="empty" hidden role="status">没有找到匹配文章，试试其他关键词。</p><script src="../scripts/filter.ts"/></Layout>
